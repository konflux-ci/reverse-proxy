{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "gomod": {
    "packageRules": [
      {
        "matchDepTypes": ["indirect"],
        "enabled": false
      }
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.govulncheck-version$/"
      ],
      "matchStrings": ["(?<currentValue>v\\d+\\.\\d+\\.\\d+)(?:\\s|$)"],
      "depNameTemplate": "golang.org/x/vuln",
      "datasourceTemplate": "go"
    }
  ]
}
